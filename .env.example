# ── Web console ─────────────────────────────────────────────
# PORT is injected by Railway automatically; only set WEB_PORT for local override.
# Set BOTH of these to password-protect the console (recommended for Railway):
WEB_USER=
WEB_PASS=

# ── Business Central ────────────────────────────────────────
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_ENVIRONMENT=PILOT
BC_COMPANY=Parsons-Kellogg

# ── Deposco ─────────────────────────────────────────────────
DEPOSCO_AUTH_URL=https://auth.deposco.com/oauth2/token
DEPOSCO_API_BASE=https://api.deposco.com/latest
DEPOSCO_CLIENT_ID=
DEPOSCO_CLIENT_SECRET=
DEPOSCO_REFRESH_TOKEN=
DEPOSCO_ENV=releasesupport
DEPOSCO_COMPANY=HIVE

# Deposco-side integration ("socket") name for an item's channel listing — carries the BC
# back-reference (ref1=Item_No, ref2=Variant_Code, ref4=WebshopVariantCode).
# Unset/empty => no `channels` at all: item master only, no listing, no BC back-reference.
# Set it to the socket name for the target env before you want channel listings written.
DEPOSCO_INTEGRATION_NAME=

# Note: the loop-mode gates (TO_PUSH_ENABLED etc.) are NOT needed here — a single-order
# --order run (what every button does) forces push + post on for that one order.

# ── Alerts (permanent sync failures → email / webhook; always logged to sync_alerts + /alerts) ──
# Sweep runs in the console server every ALERT_SCHEDULE_MS (default 300000; 0 disables).
ALERT_SCHEDULE_MS=300000
# Transient inventory failure counts as "stuck" (and alerts) after this many failed ticks.
ALERT_STUCK_HITS=6
# Teams chat/channel via Workflows ("Post to a chat when a webhook request is received") — the URL
# is auto-detected and gets an Adaptive Card; Slack or anything else gets {text}. Override with
# ALERT_WEBHOOK_FORMAT=teams|slack|json.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=
# Email via Microsoft Graph sendMail. Needs Mail.Send APPLICATION permission (+ admin consent) on
# the Entra app (defaults to the BC_* app; override with ALERT_GRAPH_TENANT_ID/CLIENT_ID/CLIENT_SECRET)
# and a licensed sender mailbox. Test with: node dist/sync/alerts.js --test
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Link appended to every alert (the console's public URL).
ALERT_CONSOLE_URL=

# ── Tech x Ops 2026-09-22 features (all default ON except where noted) ──
# PO push: BC vendor name → Deposco consigneePartner (find-or-creates the trading partner).
PO_CONSIGNEE_PARTNER_ENABLED=true
# PO receipts post on the Deposco received date ('received') or the order header date ('header').
PO_RECEIPT_POSTING_DATE=received
# Return receipts: same switch, default 'header' until accounting confirms.
RO_RECEIPT_POSTING_DATE=header
# Inventory adjustments: 'deposco' posts on Deposco's adjustment date; default 'workdate' (unchanged).
INV_POSTING_DATE=workdate
# CO push: BC salesperson name → Deposco customAttribute5 (+ salesRepContact).
SO_SALES_REP_ENABLED=true
# TO: Deposco tracking → posted transfer shipment (AL >= 2.18).
TO_TRACKING_ENABLED=true
